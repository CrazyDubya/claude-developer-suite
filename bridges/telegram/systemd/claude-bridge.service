[Unit]
Description=SpreadtheEcho - Claude Telegram Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h
ExecStart=/usr/bin/python3 %h/SpreadtheEcho/scripts/watchdog.py
Restart=always
RestartSec=10
StandardOutput=append:%h/.claude-bridge/watchdog.log
StandardError=append:%h/.claude-bridge/watchdog.log

# Environment
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-%h/.claude-bridge.env

# Security
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=default.target
